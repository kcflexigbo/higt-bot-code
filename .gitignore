# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Data — keep tree, ignore contents
data/raw/*
data/processed/*
data/graphs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/graphs/.gitkeep
# But DO keep inspection logs — they're cheap text snapshots, useful as evidence
!data/inspection_logs/

# Experiment artifacts
experiments/*/
!experiments/lodo/
wandb/
outputs/
multirun/
*.pt
*.ckpt
*.parquet

# Notebook checkpoints
.ipynb_checkpoints/

# Regenerated graph variants and caches (rebuild with scripts/relabel_infected_src.py,
# scripts/refeature_graphs.py, scripts/cache_embeddings*.py)
data/graphs_src/
data/graphs_src2/
data/graphs_v3/
data/flow_embeddings*/
data/inspection_logs/**/cache_*.npz
data/inspection_logs/**/emb/
# Per-window prediction arrays (~1.3 GB): regenerate with the scripts, or archive separately (e.g. Zenodo)
data/inspection_logs/**/*.npz
